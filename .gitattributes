# Единый стиль переводов строк для всего репозитория.
# Файлы хранятся в git с LF, в рабочей копии тоже LF —
# это убирает «весь файл изменён» из-за CRLF на Windows.
* text=auto eol=lf

# Бинарные файлы, которые git не должен трогать
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.pdf binary
*.cast binary
